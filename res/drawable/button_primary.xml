<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#b8f7e23b" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/accent_bright" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent_bright" /><corners android:radius="2dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/accent" /><corners android:radius="2dp" /></shape>
    </item>
</selector>
