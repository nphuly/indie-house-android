<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in and invite screen. android:tag picks the bundled font (see Theme.applyFonts). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/connect_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/hero_fade" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- VI | EN, filled in by MainActivity.localeSwitch. -->
            <LinearLayout
                android:id="@+id/locale_switch"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="right"
                android:layout_marginBottom="44dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/instance_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/mark_tile">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/brand_mark" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/library_name"
                        style="@style/IndieText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:tag="bold"
                        android:textSize="16sp"
                        tools:text="Indie House" />

                    <TextView
                        android:id="@+id/library_origin"
                        style="@style/IndieText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:tag="mono"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        tools:text="music.example.com" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/verified"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/login_heading"
                style="@style/IndieDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:tag="extrabold"
                android:textSize="28sp"
                tools:text="Đăng nhập để nghe" />

            <TextView
                android:id="@+id/login_hint"
                style="@style/IndieBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="14sp"
                tools:text="Dùng tài khoản Indie House của bạn." />

            <LinearLayout
                android:id="@+id/invite_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/IndieEyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:tag="mono"
                    android:text="@string/invite_code" />

                <EditText
                    android:id="@+id/invite_input"
                    style="@style/IndieInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/invite_code_hint"
                    android:inputType="textNoSuggestions" />

                <TextView
                    style="@style/IndieEyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:tag="mono"
                    android:text="@string/display_name" />

                <EditText
                    android:id="@+id/name_input"
                    style="@style/IndieInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/display_name_hint"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <TextView
                style="@style/IndieEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:tag="mono"
                android:text="@string/email" />

            <EditText
                android:id="@+id/email_input"
                style="@style/IndieInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/IndieEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:tag="mono"
                android:text="@string/password" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <EditText
                    android:id="@+id/password_input"
                    style="@style/IndieInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:paddingRight="52dp" />

                <ImageView
                    android:id="@+id/password_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="right|center_vertical"
                    android:background="@drawable/icon_touch"
                    android:clickable="true"
                    android:contentDescription="@string/show_password"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <TextView
                android:id="@+id/form_error"
                style="@style/IndieError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                tools:text="Email hoặc mật khẩu không đúng."
                tools:visibility="visible" />

            <Button
                android:id="@+id/sign_in_button"
                style="@style/IndieButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:tag="bold"
                tools:text="Đăng nhập" />

            <Button
                android:id="@+id/invite_toggle"
                style="@style/IndieButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:tag="bold"
                android:visibility="gone"
                tools:text="Tôi có mã mời"
                tools:visibility="visible" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/change_library"
                style="@style/IndieButton.Ghost"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:tag="semibold"
                android:text="@string/change_library"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
