<?xml version="1.0" encoding="utf-8"?>
<!-- Connection screen. android:tag picks the bundled font (see Theme.applyFonts). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/connect_hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/hero_fade" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/brand_mark" />

                <TextView
                    style="@style/IndieText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:tag="extrabold"
                    android:text="INDIE HOUSE"
                    android:textSize="18sp" />

                <!-- VI | EN, filled in by MainActivity.localeSwitch. -->
                <LinearLayout
                    android:id="@+id/locale_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="150dp" />

            <TextView
                style="@style/IndieDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="extrabold"
                android:text="@string/connect_title" />

            <TextView
                style="@style/IndieBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/connect_lede" />

            <TextView
                style="@style/IndieEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="8dp"
                android:tag="mono"
                android:text="@string/connect_address" />

            <EditText
                android:id="@+id/address_input"
                style="@style/IndieInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="https://music.example.com"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                tools:text="https://music.example.com" />

            <TextView
                android:id="@+id/connect_error"
                style="@style/IndieError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:text="Không kết nối được máy chủ. Kiểm tra mạng rồi thử lại."
                tools:visibility="visible" />

            <Button
                android:id="@+id/connect_button"
                style="@style/IndieButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:tag="bold"
                android:text="@string/connect_button" />

            <LinearLayout
                android:id="@+id/scan_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_secondary"
                android:clickable="true"
                android:contentDescription="@string/scan_qr_description"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_qr" />

                <TextView
                    style="@style/IndieText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="bold"
                    android:text="@string/scan_qr"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/accent" />

                <TextView
                    style="@style/IndieText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/connect_note"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
